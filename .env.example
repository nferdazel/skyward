# Skyward — environment contoh (monorepo).
#
# Salin ke `.env` untuk dev lokal. JANGAN commit `.env` asli.
# Di produksi, nilai asli hanya di server (mode 600).

# ── Backend API (apps/api) ──
# Dibaca oleh apps/api/internal/config/config.go. Prefix SKYWARD_ kecuali
# PORT/HOST/DATABASE_URL/CORS_ALLOWED_ORIGINS.
SKYWARD_ENV=dev
PORT=8090
HOST=127.0.0.1
DATABASE_URL=postgres://qouver:qouver_pass@localhost:5432/skyward_dev?sslmode=disable
SKYWARD_JWT_SECRET=dev-secret-key-change-in-production-12345
SKYWARD_LOG_LEVEL=debug
# SKYWARD_LOG_DIR=/var/log/skyward
# SKYWARD_ADMIN_TOKEN=            # WAJIB di prod; kosong = /admin/* mati (503)
# CORS_ALLOWED_ORIGINS=https://skyward.qouver.com
# SKYWARD_TRUSTED_PROXIES=127.0.0.0/8,::1
# SKYWARD_RATE_LIMIT_PER_MIN=2400
# SKYWARD_WORKER_ENABLED=true
# SKYWARD_WORKER_TICK_INTERVAL_SECONDS=60
# PUBLIC_BASE_URL=

# ── Frontend web (apps/web) ──
# Vite hanya mengekspos variabel ber-prefix VITE_ ke klien.
# Prod: https://api.qouver.com/skyward
VITE_SKYWARD_API_URL=http://localhost:8090
